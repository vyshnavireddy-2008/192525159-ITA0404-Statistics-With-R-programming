# Create data frame
exam_data <- data.frame(
  Name = c("Anu", "Bala", "Charan", "Divya", "Esha"),
  Score = c(85, 72, 90, 65, 78),
  Attempts = c(1, 2, 1, 3, 2),
  Qualify = c(TRUE, TRUE, TRUE, FALSE, TRUE)
)

# Display data frame
print(exam_data)

# Extract first two rows
print(exam_data[1:2, ])

# Extract Score column
print(exam_data$Score)

# Add a new row
new_row <- data.frame(
  Name = "Farhan",
  Score = 88,
  Attempts = 1,
  Qualify = TRUE
)

exam_data <- rbind(exam_data, new_row)

# Add a new column
exam_data$Grade <- c("B", "C", "A", "D", "C", "B")

# Sort by Score (Descending)
sorted_data <- exam_data[order(-exam_data$Score), ]
print(sorted_data)

# Save to CSV file
write.csv(exam_data, "exam_data.csv", row.names = FALSE)
