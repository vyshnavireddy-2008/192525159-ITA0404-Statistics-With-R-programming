# Create a vector
v <- c(10, 20, 30, 40, 50)

# Create a matrix
m <- matrix(c(1, 2, 3, 4, 5, 6),
            nrow = 2,
            ncol = 3,
            byrow = TRUE)

# Create a function
square <- function(x) {
  return(x^2)
}

# Create a list
my_list <- list(
  Vector = v,
  Matrix = m,
  Function = square
)

# Display the entire list
cat("List Contents:\n")
print(my_list)

# Display vector
cat("\nVector:\n")
print(my_list$Vector)

# Display matrix
cat("\nMatrix:\n")
print(my_list$Matrix)

# Use the function stored in the list
cat("\nSquare of 5:\n")
print(my_list$Function(5))
