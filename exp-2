# -------------------------
# 5 x 4 Matrix (filled by row)
# -------------------------
mat5x4_row <- matrix(1:20, nrow = 5, ncol = 4, byrow = TRUE)

rownames(mat5x4_row) <- paste0("R", 1:5)
colnames(mat5x4_row) <- paste0("C", 1:4)

mat5x4_row


# -------------------------
# 5 x 4 Matrix (filled by column)
# -------------------------
mat5x4_col <- matrix(1:20, nrow = 5, ncol = 4, byrow = FALSE)

rownames(mat5x4_col) <- paste0("R", 1:5)
colnames(mat5x4_col) <- paste0("C", 1:4)

mat5x4_col


